# These schemas are registered on the saved Foundry Prompt Agent once.
# They are NOT sent with every Responses API request.

def _object_schema(
    properties: dict[str, Any],
    required: list[str],
) -> dict[str, Any]:
    return {
        "type": "object",
        "properties": properties,
        "required": required,
        "additionalProperties": False,
    }


